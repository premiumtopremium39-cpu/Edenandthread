# =============================================================
# EDEN & THREADS — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================

# -------------------------------------------------------------
# SUPABASE CONFIGURATION (Frontend Client - Safe with RLS)
# -------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# -------------------------------------------------------------
# SUPABASE CONFIGURATION (Backend Server - Secret & Protected)
# -------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# -------------------------------------------------------------
# RAZORPAY PAYMENT & WEBHOOK CONFIGURATION (Server-Side Secrets)
# -------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_or_live_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
RAZORPAY_CONFIG_ID=config_Tsrko6CbrIPYEM

# Frontend Public Razorpay Keys
VITE_RAZORPAY_KEY_ID=rzp_test_or_live_key_id
VITE_RAZORPAY_CONFIG_ID=config_Tsrko6CbrIPYEM

# -------------------------------------------------------------
# TRANSACTIONAL EMAIL NOTIFICATIONS (Resend or Authenticated SMTP)
# -------------------------------------------------------------
STORE_OWNER_EMAIL=owner@edenthreads.luxury
EMAIL_FROM="EDEN & THREAD" <orders@edenthreads.luxury>
EMAIL_PROVIDER_API_KEY=re_your_resend_api_key_here
PUBLIC_SITE_URL=https://eden-threads.vercel.app

# Optional Authenticated SMTP Alternative:
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@yourdomain.com
# SMTP_PASS=your_smtp_password_here

# -------------------------------------------------------------
# SHADOWFAX FORWARD LOGISTICS (Shipping & Dispatch API)
# -------------------------------------------------------------
# Official API: https://developer.shadowfax.in/docs/api/forward-logistics
SHADOWFAX_API_TOKEN=your_shadowfax_token_here
SHADOWFAX_BASE_URL=https://staging.shadowfax.in
SHADOWFAX_PICKUP_PINCODE=560001
SHADOWFAX_PICKUP_ADDRESS="Eden & Thread Atelier, European Quarter, Richmond Town, Bangalore"
SHADOWFAX_PICKUP_PHONE=9876543210
SHADOWFAX_PICKUP_NAME="Eden & Thread Atelier Dispatch"

# -------------------------------------------------------------
# RESERVATION CLEANUP CRON SECURITY
# -------------------------------------------------------------
CRON_SECRET=your_long_random_cron_cleanup_secret_here
PORT=5000
